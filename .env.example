# Database Configuration (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgresql://username:password@hostname:6543/database

# Optional Direct Connection for Migrations
MIGRATION_DATABASE_URL=postgresql://username:password@hostname:5432/database

# CORS Configuration
API_CORS_ORIGINS=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Blockchain EVM Configuration (Ganache local testnet)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
CONTRACT_ADDRESS=0xd359Ed83d80A58272Bae78475c80665035942241
CHAIN_ID=1337

# Frontend Backend Reference (Optional for separate origin dev)
VITE_API_BASE_URL=http://127.0.0.1:8000
